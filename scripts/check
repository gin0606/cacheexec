#!/usr/bin/env bash
set -euo pipefail

cargo_bin="${CARGO:-}"
rustup_cargo="${CARGO_HOME:-${HOME:-}/.cargo}/bin/cargo"
if [ -z "$cargo_bin" ] && [ -x "$rustup_cargo" ]; then
  cargo_bin="$rustup_cargo"
fi
if [ -z "$cargo_bin" ]; then
  cargo_bin="$(command -v cargo)"
fi

"$cargo_bin" fmt --check
"$cargo_bin" clippy --locked --all-targets -- -D warnings
"$cargo_bin" test --locked
nix flake check path:. --print-build-logs
